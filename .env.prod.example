# ============================================================
# Equime — variables d'environnement (PRODUCTION)
# Copier ce fichier en `.env.prod` puis renseigner des secrets forts.
# Aucune valeur sensible ne doit être committée.
#
# Usage :
#   cp .env.prod.example .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# ============================================================

# --- Général ---
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
# Origine(s) CORS du front public (HTTPS)
CORS_ORIGIN=https://example.fr

# --- PostgreSQL ---
# Requises par docker-compose.prod.yml (${POSTGRES_USER:?} …)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=equime

# --- Authentification ---
# Secret de signature des access tokens JWT — ≥ 32 caractères.
# Compose refuse de démarrer sans cette variable :
#   JWT_ACCESS_SECRET: ${JWT_ACCESS_SECRET:?JWT_ACCESS_SECRET requis}
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
APP_URL=https://example.fr

# --- Emails (SendGrid) ---
SENDGRID_API_KEY=
MAIL_FROM=no-reply@example.fr

# --- Club (PDF de facture, coordonnées publiques) ---
CLUB_NAME=Equime
CLUB_ADDRESS=12 chemin des Écuries, 31000 Toulouse
CLUB_PHONE=05 61 00 00 00
CLUB_EMAIL=contact@equime.local

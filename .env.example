# ============================================================
# Equime — variables d'environnement (développement)
# Copier ce fichier en `.env` puis adapter les valeurs.
# Aucune valeur sensible ne doit être committée.
# ============================================================

# --- Général ---
# development | test | production
NODE_ENV=development

# --- API (apps/api) ---
# Port d'écoute de l'API Express
PORT=3000
# Niveau de log pino : trace | debug | info | warn | error | fatal
LOG_LEVEL=debug
# Origines autorisées par CORS (séparées par des virgules)
CORS_ORIGIN=http://localhost:5173

# --- Redis ---
# En dev Docker, le service s'appelle `redis` (voir docker-compose.yml)
REDIS_URL=redis://localhost:6379

# --- PostgreSQL (utilisé à partir de la Phase 1 — Prisma) ---
POSTGRES_USER=equime
POSTGRES_PASSWORD=equime_dev_password
POSTGRES_DB=equime
# DATABASE_URL=postgresql://equime:equime_dev_password@localhost:5432/equime

# --- Frontend (apps/web) ---
# Cible du proxy Vite pour /api (en compose : http://api:3000)
VITE_PROXY_TARGET=http://localhost:3000

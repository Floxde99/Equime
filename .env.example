# ============================================================
# Equime — variables d'environnement (développement)
# Copier ce fichier en `.env` puis adapter les valeurs.
# Aucune valeur sensible ne doit être committée.
# ============================================================

# --- Général ---
# development | test | production
NODE_ENV=development

# --- API (apps/api) ---
# Port d'écoute de l'API Express
PORT=3000
# Niveau de log pino : trace | debug | info | warn | error | fatal
LOG_LEVEL=debug
# Origines autorisées par CORS (séparées par des virgules)
CORS_ORIGIN=http://localhost:5173

# --- Redis ---
# En dev Docker, le service s'appelle `redis` (voir docker-compose.yml)
REDIS_URL=redis://localhost:6379
# Tests API (Vitest) : Redis db 1 pour isoler les clés du dev (db 0).
# Si défini, surcharge REDIS_URL dans apps/api/vitest.config.js.
# REDIS_URL_TEST=redis://localhost:6379/1

# --- PostgreSQL (Prisma) ---
POSTGRES_USER=equime
POSTGRES_PASSWORD=equime_dev_password
POSTGRES_DB=equime
# URL utilisée par l'API et le CLI Prisma. Hôte `localhost` hors Docker,
# `postgres` dans le réseau compose (le compose la construit automatiquement).
# Requise : l'API refuse de démarrer sans elle.
DATABASE_URL=postgresql://equime:equime_dev_password@localhost:5432/equime
# Tests API (Vitest + globalSetup) : base dédiée, jamais la base de dev.
# Si défini, surcharge DATABASE_URL dans apps/api/vitest.config.js.
# DATABASE_URL_TEST=postgresql://equime:equime_dev_password@localhost:5432/equime_test

# --- Authentification (apps/api) ---
# Secret de signature des access tokens JWT — ≥ 32 caractères, à régénérer
# par environnement : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change_me_dev_secret_at_least_32_characters_long
# Durées de vie (access en minutes, refresh en jours)
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
# URL publique du front (liens dans les emails)
APP_URL=http://localhost:5173

# --- Emails (SendGrid) ---
# Optionnelle en dev : sans clé, les emails sont loggés au lieu d'être envoyés
# (facture envoyée / relancée / paiement confirmé, reset mot de passe,
# confirmation d'inscription newsletter via POST /api/v1/public/newsletter).
SENDGRID_API_KEY=
MAIL_FROM=no-reply@equime.local

# Répertoire des fichiers téléversés (documents cavaliers)
UPLOAD_DIR=./uploads

# Émetteur des PDF de facture (coordonnées publiques, pas de secrets)
CLUB_NAME=Equime
CLUB_ADDRESS=12 chemin des Écuries, 31000 Toulouse
CLUB_PHONE=05 61 00 00 00
CLUB_EMAIL=contact@equime.local

# --- Frontend (apps/web) ---
# Cible du proxy Vite pour /api (en compose : http://api:3000)
VITE_PROXY_TARGET=http://localhost:3000
# Hot reload Vite sous Docker / certains volumes Windows : polling au lieu d'inotify.
# Lu par apps/web/vite.config.js (`server.watch.usePolling`).
# CHOKIDAR_USEPOLLING=true
# Coordonnées publiques du club (vitrine, Excel 1.1) — pas de secrets
VITE_CLUB_ADDRESS=12 chemin des Écuries, 31000 Toulouse
VITE_CLUB_PHONE=05 61 00 00 00
VITE_CLUB_EMAIL=contact@equime.local
# Licence FFE et cotisation club (vitrine, centimes). Optionnel : laisser vide
# pour masquer la ligne. Aucun tarif métier n'existe en schéma / seed / Excel.
# Exemple : 3500 → 35,00 €
VITE_CLUB_LICENSE_CENTS=
VITE_CLUB_COTISATION_CENTS=

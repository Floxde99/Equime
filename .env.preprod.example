# ============================================================
# Equime — variables PRÉPRODUCTION (.env.preprod)
# Copier en `.env.preprod` — ne jamais committer les secrets réels.
# ============================================================

NODE_ENV=production
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=https://preprod.equime.fr
APP_URL=https://preprod.equime.fr

POSTGRES_USER=equime_preprod
POSTGRES_PASSWORD=change_me_preprod_strong_password
POSTGRES_DB=equime_preprod
# DATABASE_URL est reconstruite par docker-compose.preprod.yml a partir des
# variables POSTGRES_* ci-dessus (la cle `environment:` prime sur `env_file:`).

REDIS_URL=redis://redis:6379

JWT_ACCESS_SECRET=change_me_preprod_jwt_secret_at_least_32_chars
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

SENDGRID_API_KEY=
MAIL_FROM=no-reply@equime.fr
UPLOAD_DIR=/app/uploads

# --- Club (PDF de facture, coordonnees publiques) ---
CLUB_NAME=Equime
CLUB_ADDRESS=12 chemin des Ecuries, 31000 Toulouse
CLUB_PHONE=05 61 00 00 00
CLUB_EMAIL=contact@equime.fr

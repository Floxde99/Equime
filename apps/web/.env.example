# Frontend Equime — variables Vite (préfixe VITE_ uniquement).
# Copier vers `.env` dans ce dossier, ou renseigner les mêmes clés à la racine
# du monorepo (vite.config.js lit l'envDir racine).

# Cible du proxy Vite pour /api (en compose : http://api:3000)
VITE_PROXY_TARGET=http://localhost:3000

# Coordonnées publiques du club (vitrine, Excel 1.1) — pas de secrets
VITE_CLUB_ADDRESS=12 chemin des Écuries, 31000 Toulouse
VITE_CLUB_PHONE=05 61 00 00 00
VITE_CLUB_EMAIL=contact@equime.local

# Licence FFE et cotisation club (vitrine, centimes). Optionnel : laisser vide
# pour masquer la ligne. Aucun tarif métier n'est fourni par le schéma / seed /
# Excel — renseigner uniquement un montant réel du club.
# Exemple : 3500 → 35,00 €
VITE_CLUB_LICENSE_CENTS=
VITE_CLUB_COTISATION_CENTS=
